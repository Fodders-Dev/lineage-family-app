<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ru.rustore.sdk</groupId>
  <artifactId>review</artifactId>
  <version>10.0.0</version>
  <packaging>aar</packaging>
  <!-- Синтезировано из разрешённого дерева Gradle: артефакт RuStore SDK,
       оригинальный Artifactory (artifactory-external.vkpartner.ru) не
       отвечает. Зависимости зафиксированы на разрешённых версиях. -->
  <dependencies>
    <dependency>
      <groupId>ru.rustore.sdk</groupId>
      <artifactId>core</artifactId>
      <version>10.3.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib-jdk8</artifactId>
      <version>1.9.25</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>ru.rustore.sdk</groupId>
      <artifactId>analytics</artifactId>
      <version>10.3.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>ru.rustore.sdk</groupId>
      <artifactId>activitylauncher</artifactId>
      <version>10.3.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>ru.rustore.sdk</groupId>
      <artifactId>metrics</artifactId>
      <version>10.3.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>ru.rustore.sdk</groupId>
      <artifactId>reactive</artifactId>
      <version>10.3.0</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
