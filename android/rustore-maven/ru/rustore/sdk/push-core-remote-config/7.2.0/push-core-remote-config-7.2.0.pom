<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ru.rustore.sdk</groupId>
  <artifactId>push-core-remote-config</artifactId>
  <version>7.2.0</version>
  <packaging>aar</packaging>
  <!-- Синтезировано из разрешённого дерева Gradle: артефакт RuStore SDK,
       оригинальный Artifactory (artifactory-external.vkpartner.ru) не
       отвечает. Зависимости зафиксированы на разрешённых версиях. -->
  <dependencies>
    <dependency>
      <groupId>ru.rustore.sdk</groupId>
      <artifactId>push-common</artifactId>
      <version>7.2.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib-jdk8</artifactId>
      <version>1.9.25</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>ru.rustore.sdk</groupId>
      <artifactId>push-core-network</artifactId>
      <version>7.2.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core-ktx</artifactId>
      <version>1.18.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.work</groupId>
      <artifactId>work-runtime-ktx</artifactId>
      <version>2.7.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core-jvm</artifactId>
      <version>1.10.2</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
